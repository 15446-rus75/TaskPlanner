QMainWindow {
  background-color: #e8eaf6;
}
QWidget {
  color: #212121;
  font-family: &quot;Segoe UI&quot;, Arial, sans-serif;
  font-size: 12px;
}
QTabWidget::pane {
  background-color: #e8eaf6;
  border: none;
}
QTabBar::tab {
  background-color: #ffffff;
  color: #212121;
  border: 1px solid #c5cae9;
  border-bottom: none;
  border-top-left-radius: 6px;
  border-top-right-radius: 6px;
  padding: 8px 16px;
  margin-right: 2px;
  font-weight: bold;
}
QTabBar::tab:selected {
  background-color: #3f51b5;
  color: #ffffff;
  border-color: #3f51b5;
}
QTabBar::tab:hover:!selected {
  background-color: #e8eaf6;
}
QPushButton {
  background-color: #ffffff;
  color: #212121;
  border: 1px solid #c5cae9;
  border-radius: 6px;
  padding: 6px 12px;
  font-weight: bold;
  min-height: 32px;
  font-size: 12px;
}
QPushButton:hover {
  background-color: #f5f5f5;
  border-color: #9fa8da;
}
QPushButton:pressed {
  background-color: #e8eaf6;
  border-color: #3f51b5;
}
QLineEdit {
  background-color: #ffffff;
  color: #000000;
  border: 1px solid #c5cae9;
  border-radius: 4px;
  padding: 4px 8px;
  font-size: 12px;
}
QLineEdit:focus {
  border: 2px solid #3f51b5;
}
QTextEdit {
  background-color: #ffffff;
  color: #000000;
  border: 1px solid #9fa8da;
  border-radius: 4px;
  padding: 4px 8px;
  font-size: 12px;
}
QTextEdit:focus {
  border: 2px solid #3f51b5;
}
QComboBox {
  background-color: #ffffff;
  color: #000000;
  border: 1px solid #c5cae9;
  border-radius: 4px;
  padding: 4px 8px;
  min-width: 80px;
  font-size: 12px;
}
QComboBox:hover {
  border: 1px solid #9fa8da;
}
QComboBox::drop-down {
  border: none;
  width: 16px;
}
QComboBox QAbstractItemView {
  background-color: #ffffff;
  color: #000000;
  selection-background-color: #e8eaf6;
  border: 1px solid #c5cae9;
}
QCheckBox {
  color: #000000;
  spacing: 6px;
  font-size: 12px;
}
QCheckBox::indicator {
  width: 14px;
  height: 14px;
  border: 2px solid #9fa8da;
  border-radius: 3px;
  background-color: #ffffff;
}
QCheckBox::indicator:checked {
  background-color: #3f51b5;
